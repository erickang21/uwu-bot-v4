# Main bot token
TOKEN=
# Dev bot token
TOKEN_DEV=
# Bot client ID (used for registering slash commands)
CLIENT_ID=
# MongoDB Database URL
MONGODB=
# Top.gg API token
TOPGG_API=
# Gelbooru API key
GELBOORU_API_KEY=
# Gelbooru User ID
GELBOORU_USER_ID=

# --- Test harness (tests/discord_harness.js, development only) ---
# Channel the harness posts commands in and watches for responses.
TEST_CHANNEL=
# Optional: token the harness logs in with. Defaults to TOKEN_DEV.
TEST_TOKEN=
# Optional: id of the bot under test. Defaults to the harness's own user id.
TEST_BOT_ID=
